{
  "schema_version": 1,
  "name": "v20_detection_mechanisms",
  "datasets": ["OPS-SAT", "SMAP", "MSL"],
  "variants": ["encoder_only", "single_pass", "shared_decoder", "reference"],
  "seeds": [2026, 2027, 2028],
  "analysis_configurations": ["compact", "window_only", "ff_only", "reference"],
  "formats": ["fp32", "int8", "int4"],
  "training_configuration": "reference",
  "conditions": ["observed_current", "hidden_current"],
  "epochs": 50,
  "native_validation_fraction": 0.2,
  "baselines": ["persistence", "past_median"],
  "evaluation": {
    "fixed_alpha": 0.5,
    "nominal_calibration_quantile": 0.99,
    "segment_quantile": 0.95,
    "bf_threshold_steps": 200,
    "batch_size_by_dataset": {"OPS-SAT": 256, "SMAP": 128, "MSL": 64},
    "histogram_bins": 50
  },
  "storage": {
    "max_planned_gib": 1.0,
    "save_pointwise_scores": false,
    "save_reconstructions": false,
    "save_opssat_segment_scores": true,
    "epoch_checkpoints": "rolling_resume_and_final_only"
  }
}
